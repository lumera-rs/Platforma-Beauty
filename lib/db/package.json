{
  "name": "@workspace/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./schema": "./src/schema/index.ts",
    "./destructive-test-runtime": "./src/destructive-test-runtime.ts",
    "./pool-runtime": "./src/pool-runtime.ts",
    "./query-observation": "./src/query-observation.ts",
    "./migration-runtime": "./src/migration-runtime/index.ts"
  },
  "scripts": {
    "test:pool-runtime": "pnpm --filter @workspace/scripts exec tsx --test ../lib/db/src/pool-runtime.test.ts",
    "test:commerce-unique-kinds": "node --experimental-strip-types --test ./src/schema/commerce-unique-kinds.test.ts",
    "push": "drizzle-kit push --config ./drizzle.config.ts",
    "push-force": "drizzle-kit push --force --config ./drizzle.config.ts"
  },
  "dependencies": {
    "drizzle-orm": "catalog:",
    "drizzle-zod": "^0.8.3",
    "pg": "^8.23.0",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@types/pg": "^8.20.0",
    "drizzle-kit": "^0.31.10"
  }
}
