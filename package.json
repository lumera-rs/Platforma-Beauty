{
  "name": "workspace",
  "version": "0.0.0",
  "license": "MIT",
  "scripts": {
    "preinstall": "sh -c 'rm -f package-lock.json yarn.lock; case \"$npm_config_user_agent\" in pnpm/*) ;; *) echo \"Use pnpm instead\" >&2; exit 1 ;; esac'",
    "build": "pnpm run typecheck && pnpm -r --if-present run build",
    "validate:publish": "export CI=true && pnpm run build && pnpm run test:bundle-budget && pnpm run test:frontend-standards && pnpm run test:frontend-interactions && pnpm run test:monitoring && pnpm run test:backend-standards:static",
    "validate:release": "export CI=true && pnpm run validate:publish && pnpm run test:backend-standards:database && pnpm run test:business-growth-schema && pnpm run test:business-guide-pdf && pnpm run test:business-guide-links && pnpm run test:automation-provider-events && pnpm run test:sms-webhook-registration && pnpm run test:attributed-appointments-pagination && pnpm run test:campaign-attributed-appointments-window && pnpm run test:stats-compare-window-boundaries && pnpm run test:tenant-isolation && pnpm run test:query-counts && pnpm run test:catalog-cache && pnpm run test:communication-archive && pnpm run test:admin-validation && pnpm run test:admin-order-search && pnpm run test:admin-list-pagination && pnpm run test:loyalty-status && pnpm run test:admin-authz && pnpm run test:b2b-catalog && pnpm run test:education-extras && pnpm run test:admin-form-resilience && pnpm run test:salon-notifications:release && pnpm run test:retention-settings && pnpm run test:webhook-repair-selection && pnpm run test:sms-fallback-phone-notice && pnpm run test:seo",
    "bundle:check": "pnpm --filter @workspace/beauty-marketplace run bundle:check",
    "typecheck:libs": "tsc --build",
    "typecheck": "pnpm run typecheck:libs && pnpm -r --filter \"./artifacts/**\" --filter \"./scripts\" --if-present run typecheck",
    "test:admin-authz": "bash scripts/test-admin-authorization.sh",
    "test:admin-input-validation": "bash scripts/test-admin-input-validation.sh",
    "test:b2b-catalog": "bash scripts/test-b2b-catalog.sh",
    "test:education-authz": "bash scripts/test-education-authorization.sh",
    "test:education-finance": "pnpm --filter @workspace/scripts exec tsx ../artifacts/api-server/src/lib/education-financial.test.ts",
    "test:education-sessions": "pnpm --filter @workspace/scripts exec tsx ../artifacts/api-server/src/lib/education-sessions.test.ts",
    "test:retail-checkout-api": "pnpm --filter @workspace/scripts run test:retail-checkout-api",
    "test:retail-checkout": "pnpm run test:retail-checkout-api && pnpm --filter @workspace/scripts run test:retail-checkout",
    "test:shipping-config": "pnpm --filter @workspace/scripts run test:shipping-config",
    "test:education-extras": "pnpm --filter @workspace/scripts exec tsx ../artifacts/api-server/src/lib/education-extras.test.ts",
    "test:query-budgets": "pnpm --filter @workspace/scripts exec tsx --test ../artifacts/api-server/src/routes/marketplace-query-budget.test.ts",
    "test:crm-backfill": "pnpm --filter @workspace/scripts exec tsx ../artifacts/api-server/src/lib/seed.test.ts",
    "test:appointment-concurrency": "pnpm --filter @workspace/scripts exec tsx ../artifacts/api-server/src/lib/appointment-locks.test.ts && pnpm --filter @workspace/scripts exec tsx ../artifacts/api-server/src/lib/appointment-routes.test.ts",
    "test:multi-location": "NODE_ENV=test pnpm --filter @workspace/scripts exec tsx ../artifacts/api-server/src/lib/multi-location.test.ts && pnpm --filter @workspace/scripts run test:multi-location",
    "test:tenant-isolation": "NODE_ENV=test pnpm --filter @workspace/scripts exec tsx ../artifacts/api-server/src/lib/tenant-isolation.test.ts",
    "test:rescheduled-confirmations": "pnpm --filter @workspace/scripts exec tsx ../artifacts/api-server/src/lib/rescheduled-confirmation-retries.test.ts",
    "test:bundle-budget": "pnpm --filter @workspace/scripts run test:bundle-budget",
    "test:frontend-standards": "pnpm --filter @workspace/scripts run test:frontend-standards",
    "test:frontend-interactions": "pnpm --filter @workspace/scripts run test:frontend-interactions",
    "test:marketplace-typecheck": "bash scripts/test-marketplace-typecheck.sh",
    "test:monitoring": "pnpm --filter @workspace/scripts run test:monitoring",
    "test:backend-standards": "pnpm --filter @workspace/scripts run test:backend-standards",
    "test:backend-standards:static": "pnpm --filter @workspace/scripts run test:backend-standards -- --static-only",
    "test:backend-standards:database": "pnpm --filter @workspace/scripts run test:backend-standards -- --database-only",
    "test:query-counts": "NODE_ENV=test pnpm --filter @workspace/scripts exec tsx ../artifacts/api-server/src/lib/query-count.test.ts",
    "test:catalog-cache": "NODE_ENV=test pnpm --filter @workspace/scripts exec tsx ../artifacts/api-server/src/lib/catalog-cache.test.ts",
    "test:communication-archive": "NODE_ENV=test pnpm --filter @workspace/scripts exec tsx ../artifacts/api-server/src/lib/communication-archive.test.ts",
    "test:admin-validation": "NODE_ENV=test pnpm --filter @workspace/scripts exec tsx ../artifacts/api-server/src/lib/admin-validation.test.ts",
    "test:loyalty-status": "NODE_ENV=test pnpm --filter @workspace/scripts exec tsx ../artifacts/api-server/src/lib/loyalty-status.test.ts",
    "test:admin-order-search": "NODE_ENV=test pnpm --filter @workspace/scripts exec tsx ../artifacts/api-server/src/lib/admin-order-search.test.ts",
    "test:admin-list-pagination": "NODE_ENV=test pnpm --filter @workspace/scripts exec tsx ../artifacts/api-server/src/lib/admin-list-pagination.test.ts",
    "test:booking-journey": "pnpm --filter @workspace/scripts run test:booking-journey",
    "test:browser": "pnpm --filter @workspace/scripts run test:browser",
    "test:carousel": "pnpm --filter @workspace/scripts run test:carousel",
    "test:review-photo-privacy": "pnpm --filter @workspace/scripts exec tsx ../artifacts/api-server/src/lib/review-photo-privacy.test.ts && pnpm --filter @workspace/scripts run test:review-photo-privacy",
    "test:admin-review-feedback": "pnpm --filter @workspace/scripts run test:admin-review-feedback",
    "test:admin-salon-designations": "pnpm --filter @workspace/scripts run test:admin-salon-designations",
    "test:admin-form-resilience": "pnpm --filter @workspace/scripts run test:admin-form-resilience",
    "test:salon-notifications": "pnpm --filter @workspace/scripts run test:salon-notifications",
    "test:salon-notifications:release": "pnpm --filter @workspace/scripts run test:salon-notifications:release",
    "test:service-library": "pnpm --filter @workspace/scripts run test:service-library",
    "test:service-availability": "pnpm --filter @workspace/scripts run test:service-availability",
    "test:business-guide-help": "pnpm --filter @workspace/scripts run test:business-guide-help",
    "test:media": "pnpm --filter @workspace/scripts exec tsx ../artifacts/api-server/src/lib/media-routes.test.ts",
    "test:business-growth": "NODE_ENV=test pnpm --filter @workspace/scripts exec tsx ../artifacts/api-server/src/lib/business-growth.test.ts",
    "test:business-guide-pdf": "NODE_ENV=test pnpm --filter @workspace/scripts exec tsx --test ../artifacts/api-server/src/lib/business-guide-pdf.test.ts",
    "test:business-guide-links": "NODE_ENV=test pnpm --filter @workspace/scripts exec tsx --test ../artifacts/api-server/src/lib/business-guide-links.test.ts",
    "test:retention-settings": "NODE_ENV=test pnpm --filter @workspace/scripts exec tsx ../artifacts/api-server/src/lib/retention-settings.test.ts",
    "test:webhook-repair-selection": "NODE_ENV=test pnpm --filter @workspace/scripts exec tsx ../artifacts/api-server/src/lib/webhook-repair-selection.test.ts",
    "test:sms-fallback-phone-notice": "NODE_ENV=test pnpm --filter @workspace/scripts exec tsx ../artifacts/api-server/src/lib/sms-fallback-admin-phone-notice.test.ts",
    "test:sms-webhook-registration": "NODE_ENV=test pnpm --filter @workspace/scripts exec tsx ../artifacts/api-server/src/lib/sms-webhook-registration.test.ts",
    "test:business-growth-schema": "NODE_ENV=test pnpm --filter @workspace/scripts exec tsx ../artifacts/api-server/src/lib/business-growth-schema.test.ts",
    "test:automation-provider-events": "NODE_ENV=test pnpm --filter @workspace/scripts exec tsx ../artifacts/api-server/src/lib/automation-provider-events.test.ts",
    "test:attributed-appointments-pagination": "NODE_ENV=test pnpm --filter @workspace/scripts exec tsx ../artifacts/api-server/src/lib/attributed-appointments-pagination.test.ts",
    "test:campaign-attributed-appointments-window": "NODE_ENV=test pnpm --filter @workspace/scripts exec tsx ../artifacts/api-server/src/lib/campaign-attributed-appointments-window.test.ts",
    "test:stats-compare-window-boundaries": "NODE_ENV=test pnpm --filter @workspace/scripts exec tsx ../artifacts/api-server/src/lib/stats-compare-window-boundaries.test.ts",
    "test:employee-leave": "pnpm --filter @workspace/scripts exec tsx --test ../artifacts/beauty-marketplace/src/lib/employee-leave.test.ts",
    "test:seo": "pnpm --filter @workspace/beauty-marketplace run test:seo"
  },
  "private": true,
  "dependencies": {
    "@replit/connectors-sdk": "^0.4.1"
  },
  "devDependencies": {
    "prettier": "^3.9.6",
    "typescript": "~5.9.3"
  }
}
